# --- OpenStrata / build state (tool-owned, never committed) ---
#
# Not root-anchored: `ost library build libs/<module>` writes its build tree and
# its .strata target state beside the module it built, not at the repository
# root, so an anchored pattern would leave those tracked.
/build/
**/build/
/.strata/
**/.strata/
CMakeUserPresets.json
strata.lock

# CI scratch: the isolated artifact registry and the evidence files the lanes
# write. Both are produced on a runner and are uploaded as workflow artifacts,
# never committed -- but `ost ci matrix` and the bootstrap steps are runnable
# locally, so they turn up in a working tree.
/.ost-ci/
/.ost-ci-home/

# --- CMake / MSVC generated ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.dll

# --- Python cache ---
__pycache__/
*.pyc
*.pyo

# --- Editor / OS noise ---
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db
